<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>explorer_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and parameters that start the explorer demo</description>
  <maintainer email="larsivarhatledal@gmail.com">Lars Ivar Hatledal</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- What the launch files start. Listing them makes colcon build this package last. -->
  <exec_depend>explorer_sim</exec_depend>
  <exec_depend>explorer_safety</exec_depend>
  <exec_depend>explorer_nav</exec_depend>
  <exec_depend>explorer_vision</exec_depend>
  <exec_depend>explorer_dashboard</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
